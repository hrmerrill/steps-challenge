# Steps Challenge — environment variables
# Copy this file to .env and fill in real values before running.
#
#   cp .env.example .env

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.  For local dev you can use SQLite instead:
#   DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql://steps_user:CHANGE_ME@localhost:5432/steps_challenge

# Docker Compose uses these to create the PostgreSQL container:
POSTGRES_USER=steps_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=steps_challenge

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# REQUIRED — generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440          # 24 hours

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins.  Set to your production domain in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Miles Club thresholds (average steps/day) ───────────────────────────────
MILES_CLUB_HIGH=10000
MILES_CLUB_MID=5000

# ── Steps-to-miles conversion ───────────────────────────────────────────────
STEPS_PER_MILE=2000

# ── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE=5242880           # 5 MB
ALLOWED_PHOTO_TYPES=image/jpeg,image/png,image/webp,image/gif

# ── Google Health API OAuth (optional — for fitness tracker sync) ─────────
# Get credentials from Google Cloud Console → APIs & Services → Credentials.
# Enable "Google Health API" under APIs & Services → Library.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/google-health/callback

# ── Email (Mailgun) ─────────────────────────────────────────────────────
# Required for password reset emails.  Leave MAILGUN_API_KEY empty to
# log reset links to the console instead of sending real emails.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=givingfol.io
MAIL_FROM_ADDRESS=Steps Challenge <noreply@givingfol.io>

# ── Docker frontend port ───────────────────────────────────────────────────
FRONTEND_PORT=8080
